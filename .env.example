# Environment Variables Example
# Copy this file to .env.local and fill in your actual API keys.
# .env.local is gitignored and will not be committed to version control.

# Google Gemini API Key (SERVER-SIDE ONLY in production)
# Get yours from: https://aistudio.google.com/apikey
# ⚠️ SECURITY: For production, set this as an environment variable in your
# serverless platform (Vercel, Netlify, etc.) - NOT in .env.local
# The server-side proxy at /api/gemini-proxy will use this key.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key
# Get yours from: https://console.cloud.google.com/
# Enable "Maps JavaScript API" and "Maps Visualization Library"
# Restrict this key by HTTP referrer (domain) in the Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Gemini Proxy Endpoint
# Default is /api/gemini-proxy (for serverless functions)
# Set this if you deploy the proxy to a different URL
# VITE_GEMINI_PROXY_ENDPOINT=/api/gemini-proxy
