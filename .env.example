# Environment Variables Example
# Copy this file to .env.local and fill in your actual API keys.
# .env.local is gitignored and will not be committed to version control.

# Google Gemini API Key
# Get yours from: https://aistudio.google.com/apikey
# WARNING: For production, use this key server-side only to avoid exposing it in the browser.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key
# Get yours from: https://console.cloud.google.com/
# Enable "Maps JavaScript API" and "Maps Visualization Library"
# Restrict this key by HTTP referrer (domain) in the Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
